{
  "version": 1,
  "author": "Chinmay Dubey",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-arduino-uno", "id": "uno", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr1",
      "top": -140,
      "left": -60,
      "attrs": { "lux": "1000" }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": -150,
      "left": 230,
      "attrs": { "color": "yellow" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": -60,
      "left": 190,
      "rotate": 90,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "ldr1:VCC", "uno:5V", "red", [ "h0" ] ],
    [ "ldr1:GND", "uno:GND.2", "black", [ "h0" ] ],
    [ "ldr1:AO", "uno:A0", "green", [ "h0" ] ],
    [ "uno:9", "r1:1", "orange", [ "v0" ] ],
    [ "r1:2", "led1:A", "orange", [ "v0" ] ],
    [ "led1:C", "uno:GND.1", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
